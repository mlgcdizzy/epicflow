# --- Database ---
# Use the POOLED connection string here (Neon/Supabase both label it
# "pooled" or provide a port-6543 variant) — Vercel can run many concurrent
# function instances, and a direct connection runs out fast.
DATABASE_URL="postgresql://user:password@host:5432/epicflow"
# The DIRECT (non-pooled) connection string — used only for schema push/migrations.
DIRECT_URL="postgresql://user:password@host:5432/epicflow"

# --- Auth (Microsoft Entra ID / Azure AD) ---
# Create an App Registration at https://portal.azure.com > Entra ID > App registrations
# Redirect URI to register: {your domain}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- AI features (epic summaries, prioritization assistant) ---
ANTHROPIC_API_KEY=""

# --- Microsoft integrations (stretch — see README) ---
AZURE_DEVOPS_ORG_URL=""
AZURE_DEVOPS_PAT=""
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
POWER_BI_WORKSPACE_ID=""
TEAMS_WEBHOOK_URL=""
